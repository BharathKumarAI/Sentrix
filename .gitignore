# ==============================================================================
# PRISM / Sentrix Root .gitignore
# ==============================================================================

# Documents & Specs
PRISM_Detailed_System_Design.docx

# Reference assets
references/

# ==============================================================================
# Local-Only Runtime Storage, Quarantined Demonstration Assets & State
# ==============================================================================
storage/
**/storage/
.local-data/
**/.local-data/
backend/data/
**/data/logs/
local/
.local/
*.local/
mlruns/
**/mlruns/
mlartifacts/
**/mlartifacts/
.mlflow/
**/.mlflow/
wandb/
**/wandb/
.tensorboard/
**/.tensorboard/

# ==============================================================================
# Environment Variables & Configs (Frontend & Backend)
# ==============================================================================
.env
.env.*
.env.local
.env.*.local
!.env.example
!.env.template
.secrets
secrets.*

# ==============================================================================
# API Keys, Service Accounts, Auth Tokens & Package Registry Configs
